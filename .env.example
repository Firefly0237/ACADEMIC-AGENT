# ============================================================================
# CiteQuest 环境变量样例
# ============================================================================
# 复制成 .env 后按本机情况改。**这里列出的每一项都是可选的**——
# 所有参数的默认值写在 src/citequest/config/ 里，那份默认值才是决策记录 §4
# 「参数正本表」在代码里的落地。环境变量只用来覆盖部署差异（地址、密钥、开关），
# **不用来改设计参数**。要改设计参数，改 config/ 里的 default 并同步决策记录。
#
# 写法（pydantic-settings 官方形态）：前缀 CITEQUEST_，嵌套用双下划线 __。
# 优先级：CLI > 构造参数 > 环境变量 > .env > 默认值。
# ============================================================================

# ---- 全局 ----
CITEQUEST_ENV=local
CITEQUEST_DEBUG=false
CITEQUEST_LOG_LEVEL=INFO
# 容器里用 json，本地开发用 console
CITEQUEST_LOG_FORMAT=console

# ---- Milvus（决策记录 §4.2）----
CITEQUEST_MILVUS__URI=http://localhost:19530
CITEQUEST_MILVUS__TOKEN=
CITEQUEST_MILVUS__DB_NAME=default
CITEQUEST_MILVUS__COLLECTION_NAME=citequest_chunks
# 对外只用 alias，切库靠改 alias 指向；灰度与回滚都在这一行上
CITEQUEST_MILVUS__ALIAS=citequest_current
# 进响应体、进缓存 key、进 facets_exact。换它 = 一键全量缓存失效
CITEQUEST_MILVUS__INDEX_VERSION=idx_00000000_00
# 降本档①：零召回损失。与 DiskANN 互斥
CITEQUEST_MILVUS__MMAP_ENABLED=false

# ---- TEI dense 编码（决策记录 §4.3）----
# 注意是 compose 服务名而不是 localhost：**去调 TEI 的是 Milvus 容器，不是本进程**。
# Data-in/Data-out 之下客户端不做任何 embedding。
CITEQUEST_EMBEDDING__ENDPOINT=http://tei:80
CITEQUEST_EMBEDDING__MODEL_ID=BAAI/bge-m3
CITEQUEST_EMBEDDING__API_KEY=
# 首次建库后用 TEI 实测输出填入；为空时探针只做连通性检查并告警，不拒绝启动
CITEQUEST_EMBEDDING__STARTUP_PROBE_EXPECTED_SHA256=

# ---- 生成与路由模型（决策记录 §4.5）----
CITEQUEST_GENERATION__BASE_URL=http://localhost:8000/v1
CITEQUEST_GENERATION__API_KEY=EMPTY
CITEQUEST_GENERATION__MODEL_ID=Qwen2.5-7B-Instruct-AWQ
CITEQUEST_GENERATION__ROUTER_MODEL_ID=Qwen2.5-1.5B-Instruct
# 改 prompt 必须同时改版本号，否则线上指标变动无法归因
CITEQUEST_GENERATION__PROMPT_VERSION=v1

# ---- 改写：HyDE 带存活条件（跑不赢 direct 就下线）----
CITEQUEST_REWRITE__HYDE_ENABLED=true

# ---- grounding：阈值默认未标定（None），此时一律 unverified ----
# 标定完成前**不要**在这里填数——填了就等于用余弦时代的旧阈值冒充标定结果
# CITEQUEST_GROUNDING__SUPPORTED_THRESHOLD=
# CITEQUEST_GROUNDING__WEAK_THRESHOLD=

# ---- API ----
CITEQUEST_API__HOST=0.0.0.0
CITEQUEST_API__PORT=8080
CITEQUEST_API__CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# ---- Agent：纠正循环 ----
CITEQUEST_AGENT__CORRECTION_LOOP_ENABLED=true
# 尚未选型。memory 之外的值意味着声称具备持久化能力，选型前不要改
CITEQUEST_AGENT__CHECKPOINTER_BACKEND=memory

# ---- 会话记忆：v1 默认不开 ----
CITEQUEST_MEMORY__ENABLED=false

# ---- 可观测（可选外部依赖，缺省不启用）----
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
