# Nonsecret deployment references only. Copy outside Git and use --env-file.
CITEQUEST_CORE_WEB_IMAGE=citequest-core-web:development
CITEQUEST_CORE_AGENT_IMAGE=citequest-core-agent:development
CITEQUEST_CORE_BIND_ADDRESS=127.0.0.1
CITEQUEST_CORE_HTTP_PORT=18000
CITEQUEST_CORE_CONFIG_DIR=/srv/citequest/config
CITEQUEST_CORE_WEB_SECRETS_DIR=/srv/citequest/secrets/web
CITEQUEST_CORE_AGENT_SECRETS_DIR=/srv/citequest/secrets/agent
CITEQUEST_CORE_CAS_DIR=/srv/citequest/cas
CITEQUEST_CORE_TOKENIZER_FILE=/srv/citequest/assets/tokenizer.json
CITEQUEST_CORE_BUSINESS_NETWORK=citequest-business
CITEQUEST_CORE_INDEX_NETWORK=citequest-index
CITEQUEST_CORE_IDENTITY_NETWORK=citequest-identity
# Optional qualified-corpus overlay only; not read by the default composition.
CITEQUEST_CORE_NATIVE_CHAIN_FILE=/srv/citequest/assets/native-identity-chain.jsonl
