# docker compose 用的环境变量样例。复制成 docker/.env（已进 .gitignore）。
# 这一份只管**容器编排**（镜像 tag、端口、卷）；应用参数在仓库根的 .env.example。

# ---- 端口映射 ----
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
TEI_PORT=8081
API_PORT=8080

# ---- TEI：tag 前缀必须匹配本机 GPU 架构，见 docker/tei/README.md ----
# 89=Ada Lovelace(RTX 4000系) / 86=A10,RTX3090 / 80=A100 / hopper=H100 / cpu=无卡
TEI_IMAGE_TAG=89-1.9
TEI_MODEL_ID=BAAI/bge-m3
TEI_MAX_BATCH_TOKENS=16384
# 私有模型才需要；bge-m3 是公开模型，留空即可
HF_TOKEN=

# ---- Milvus ----
# 降本档①。内存放得下就别开——开了是先付性能代价换空间
MILVUS_MMAP_ENABLED=false

# ---- MinIO（Milvus standalone 的对象存储依赖）----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- 生成模型：通常直接跑在宿主机（vLLM/SGLang），不进这套 compose ----
CITEQUEST_GENERATION_BASE_URL=http://host.docker.internal:8000/v1
