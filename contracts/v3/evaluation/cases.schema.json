{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citequest.dev/contracts/v3/evaluation/cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key_id", "cases"],
  "properties": {
    "schema_version": {"const": "citequest-agent-evaluation-cases/1"},
    "key_id": {"type": "string", "pattern": "^key_[a-f0-9]{64}$"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "gold": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "publication_status": {"type": "string"}, "status": {"type": "string"},
        "completion_status": {"type": "string"}, "request_coverage": {"type": "string"},
        "evidence_status": {"type": "string"}, "school_format_ready": {"type": "boolean"},
        "submission_ready": {"type": "boolean"}, "claim_count": {"type": "integer", "minimum": 0},
        "citation_count": {"type": "integer", "minimum": 0}, "school_section_count": {"type": "integer", "minimum": 0},
        "review_finding_count": {"type": "integer", "minimum": 0}, "adopted_findings_resolved": {"type": "boolean"},
        "result_hmac": {"type": "string", "pattern": "^result_[a-f0-9]{64}$"},
        "command_outcome": {"enum": ["completed", "partial", "rejected", "terminal_failure", "cancelled", "pending", "waiting_input"]}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["tool_hmac", "arguments_hmac"],
      "properties": {
        "tool_hmac": {"type": "string", "pattern": "^tool_[a-f0-9]{64}$"},
        "arguments_hmac": {"type": "string", "pattern": "^arguments_[a-f0-9]{64}$"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["command_hmac", "source", "expected_tool_calls", "expected_result", "require_trajectory_match", "require_literal_citations", "exclude_if"],
      "properties": {
        "command_hmac": {"type": "string", "pattern": "^command_[a-f0-9]{64}$"},
        "source": {"enum": ["actual", "synthetic"]},
        "expected_tool_calls": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/tool"}},
        "expected_result": {"$ref": "#/$defs/gold"},
        "require_trajectory_match": {"type": "boolean"}, "require_literal_citations": {"type": "boolean"},
        "exclude_if": {"type": "array", "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["cancelled", "unknown_outcome", "missing_citation_evidence"]}}
      }
    }
  }
}
